# ~/app/.env na instancia. NAO commitar o .env real.
#
# IMAGE_TAG e mantido automaticamente por deploy/remote-deploy.sh (tag/SHA da imagem
# que passou no healthcheck). Edicao manual e desencorajada; para trocar a versao,
# rode o workflow Deploy com o input image_tag.
IMAGE_TAG=<sha-do-commit>
#
# O app nao le variaveis de ambiente proprias: os caminhos dos bancos SQLite sao
# derivados de process.cwd() (/app/web -> /app/data/catalog.db e /app/data/ownership.db).
# Se o app passar a usar variaveis (ex.: segredos), adicione aqui.
