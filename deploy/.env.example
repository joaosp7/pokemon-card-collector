# Copie para ~/app/.env na instancia (NAO commitar o .env real).

# Dominio publico que aponta para o IP estatico da instancia (usado pelo Caddy para HTTPS).
DOMAIN=cards.example.com

# Tag da imagem usada pelo compose (latest, ou um SHA para rollback).
IMAGE_TAG=latest

# O app nao le variaveis de ambiente proprias: os caminhos dos bancos SQLite sao
# derivados de process.cwd() (/app/web -> /app/data/catalog.db e /app/data/ownership.db).
# Se o app passar a usar variaveis (ex.: segredos), adicione aqui.
